# ─────────────────────────────────────────────────────────────────────────────
# SOMMR configuration. Copy to `.env.local` for development, and add the same
# names in Vercel → Project → Settings → Environment Variables for production.
# Everything here is read on the server only — nothing is sent to browsers.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required in production ──────────────────────────────────────────────────

# PostgreSQL connection string (Supabase, Neon, RDS or your own server).
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Leave empty in development to use the built-in PGlite database in .data/pglite.
DATABASE_URL=

# Public URL of the app, used in password-reset emails and as the referer for OpenStreetMap services.
APP_URL=http://localhost:3000

# Comma-separated emails that become admins when they sign up. (Or run `npm run make-admin -- email`.)
ADMIN_EMAILS=

# Secret for the daily import endpoint. Vercel Cron sends it automatically as a Bearer token.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# ── Event providers (optional, but What's On needs at least one source) ─────

# Ticketmaster Discovery API — free key at https://developer.ticketmaster.com (5,000 calls/day).
# Note: Ticketmaster's South African coverage on this API is limited.
TICKETMASTER_API_KEY=

# Quicket public events API — register for a key at https://developer.quicket.co.za
QUICKET_API_KEY=

# ── Email (password resets) ─────────────────────────────────────────────────

# Resend (https://resend.com). Without it, reset links are printed to the server log in
# development, and production tells the user email isn't configured.
RESEND_API_KEY=
EMAIL_FROM=SOMMR <hello@your-domain.co.za>

# ── Photo storage ───────────────────────────────────────────────────────────

# "database" (default — photos are stored in Postgres, nothing else to set up)
# or "supabase" (private Supabase Storage bucket; create the bucket first, keep it private).
STORAGE_DRIVER=database
SUPABASE_URL=
# Service role key: server-only, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sommr-media

# ── Open data services (keyless; defaults are fine) ─────────────────────────

# Overpass endpoints for OpenStreetMap places, tried in order.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Nominatim geocoder (search + venue coordinates). Respect https://operations.osmfoundation.org/policies/nominatim/
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Optional contact email sent to Nominatim per its usage policy.
NOMINATIM_EMAIL=
# Allow a slow, rate-limited Nominatim fallback when Overpass is unreachable.
# On by default in development, off in production unless set to "true".
# PLACES_NOMINATIM_FALLBACK=false
# Weather (Open-Meteo, free for non-commercial use — see https://open-meteo.com/en/pricing)
# WEATHER_URL=https://api.open-meteo.com/v1/forecast

# ── Advanced ────────────────────────────────────────────────────────────────
# DATABASE_POOL_MAX=5
# DATABASE_SSL=require          # disable | require (encrypted, default for remote) | verify (also checks the certificate)
# DATABASE_CA_CERT=             # PEM certificate to verify against when DATABASE_SSL=verify
# PGLITE_DIR=.data/pglite       # where the development database lives
