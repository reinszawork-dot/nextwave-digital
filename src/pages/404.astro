---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found" noindex>
  <section class="nf">
    <div class="container">
      <p class="code gradient-text">404</p>
      <h1>This page drifted off.</h1>
      <p class="msg">The page you are looking for doesn't exist or may have moved.</p>
      <div class="actions">
        <a href="/" class="btn btn-primary"><Icon name="arrow-left" size={16} /> Back to home</a>
        <a href="/#products" class="btn btn-ghost">See our products</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: calc(100vh - var(--header-h) - 200px);
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: 6rem;
  }
  .code { font-size: clamp(5rem, 3rem + 10vw, 9rem); font-weight: 700; letter-spacing: -0.06em; line-height: 1; }
  h1 { margin-top: 1rem; font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem); }
  .msg { margin-top: 0.75rem; color: var(--text-muted); }
  .actions { margin-top: 2rem; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .actions :global(svg) { transition: none; }
  .actions .btn:hover :global(svg) { transform: none; }
</style>
