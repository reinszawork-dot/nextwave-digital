---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Set true for pages that should not be indexed (e.g. 404). */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  description: site.description,
  ...(Astro.site ? { url: Astro.site.href, logo: new URL('/favicon.svg', Astro.site).href } : {}),
  ...(site.contactEmail ? { email: site.contactEmail } : {}),
};
---

<!doctype html>
<html lang="en-ZA" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0f22" />
    <meta name="color-scheme" content="dark light" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL('/og-image.png', Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
      // Look: Dusk (default) or Day, remembered on this device.
      try {
        if (localStorage.getItem('nw-look') === 'day') {
          document.documentElement.dataset.look = 'day';
          document.querySelector('meta[name=theme-color]')?.setAttribute('content', '#f6f3ec');
        }
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  </head>
  <body>
    <div class="site-bg" aria-hidden="true">
      <div class="sky-layer">
        <div class="sky-glow g1"></div>
        <div class="sky-glow g2"></div>
      </div>
      <div class="sea-layer">
        <div class="horizon"></div>
        <div class="sea"></div>
      <svg class="tide" viewBox="0 0 1600 400" preserveAspectRatio="none">
        <path pathLength="1" d="M0 120 C 200 80, 400 160, 600 120 S 1000 80, 1200 120 S 1500 160, 1600 120"></path>
        <path pathLength="1" d="M0 190 C 220 150, 420 230, 640 190 S 1040 150, 1260 190 S 1520 230, 1600 190"></path>
        <path pathLength="1" d="M0 260 C 180 225, 380 295, 580 260 S 980 225, 1180 260 S 1480 295, 1600 260"></path>
        <path pathLength="1" d="M0 330 C 240 300, 440 360, 680 330 S 1080 300, 1320 330 S 1540 360, 1600 330"></path>
      </svg>
      </div>
      <div class="grain"></div>
    </div>
    <div class="nav-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
