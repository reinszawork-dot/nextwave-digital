---
import BudgetPreview from './previews/BudgetPreview.astro';
import SleepPreview from './previews/SleepPreview.astro';
import HabitPreview from './previews/HabitPreview.astro';
import StudyPreview from './previews/StudyPreview.astro';
import { getProduct, type ProductId } from '../data/products';

interface Props {
  id: ProductId;
}
const { id } = Astro.props;
const product = getProduct(id)!;
const Preview = { wisely: BudgetPreview, lull: SleepPreview, kindling: HabitPreview, studyhub: StudyPreview }[id];
---

<figure class="window" style={`--p-accent:${product.accent};--p-soft:${product.accentSoft}`}>
  <div class="chrome" aria-hidden="true">
    <span></span><span></span><span></span>
    <p>{product.name}</p>
  </div>
  <div class="screen" aria-hidden="true">
    <Preview />
  </div>
  <figcaption class="sr-only">Illustrative preview of the {product.name} app with sample data.</figcaption>
</figure>

<style>
  .window {
    margin: 0;
    position: relative;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .window::before {
    content: '';
    position: absolute;
    inset: -40% -20% auto auto;
    width: 70%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, var(--p-soft), transparent);
    pointer-events: none;
  }
  .chrome {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .chrome span { width: 9px; height: 9px; border-radius: 50%; background: rgba(41, 37, 30, 0.12); }
  .chrome p { margin-left: auto; margin-right: auto; padding-right: 33px; font-size: 0.72rem; color: var(--text-faint); font-weight: 500; }
  .screen { position: relative; padding: 1.15rem 1.15rem 1.3rem; }
</style>
