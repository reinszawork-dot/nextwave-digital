---
import Icon from './Icon.astro';
import ProductIcon from './ProductIcon.astro';
import LineChart from './charts/LineChart.astro';
import BarChart from './charts/BarChart.astro';
import Ring from './charts/Ring.astro';
import Counter from './charts/Counter.astro';
import { products, getProduct } from '../data/products';
import { showcase } from '../data/showcase';
import { site } from '../data/site';

const wisely = getProduct('wisely')!;
const lull = getProduct('lull')!;
const kindling = getProduct('kindling')!;
const w = showcase.wisely.line;
---

<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="blob b3"></div>
    <div class="dots"></div>
  </div>

  <div class="container hero-inner">
    <p class="pill rise">
      <span class="pill-dot" aria-hidden="true"></span>
      A software company for everyday life
    </p>

    <h1 id="hero-title" class="rise" style="--reveal-delay: 80ms">
      Technology designed to make <span class="em">everyday life better.</span>
    </h1>

    <p class="lede rise" style="--reveal-delay: 180ms">
      {site.name} designs and builds practical apps for the things that fill your days — your money,
      your rest, your routines and your studies. Simple to use, private by design and made to genuinely help.
    </p>

    <div class="actions rise" style="--reveal-delay: 280ms">
      <a href="#products" class="btn btn-primary btn-lg">
        Explore our products
        <Icon name="arrow-right" size={16} />
      </a>
      <a href="#about" class="btn btn-ghost btn-lg">About NextWave</a>
    </div>

    <!-- Floating product previews (illustrative, sample data) -->
    <div class="stage rise" style="--reveal-delay: 420ms">
      <div class="float f-main" style={`--p-accent:${wisely.accent}`}>
        <div class="glass-card">
          <div class="gc-head">
            <ProductIcon id="wisely" size={28} />
            <span class="gc-name">Wisely</span>
            <span class="gc-sub">{w.title}</span>
          </div>
          <LineChart
            labels={w.labels}
            series={w.series.map((s) => ({ ...s, color: s.color ?? wisely.accent }))}
            unit={w.unit}
            labelEvery={3}
            height={210}
            label="Wisely sample chart: spending versus budget pace this pay month"
          />
        </div>
      </div>

      <div class="float f-ring">
        <div class="glass-card mini">
          <div class="gc-head"><ProductIcon id="lull" size={24} /><span class="gc-name">Lull</span></div>
          <Ring value={5} max={7} display="5/7" label="Wind-down nights" sub="This week" color={lull.accent} size={96} stroke={9} />
        </div>
      </div>

      <div class="col-right">
      <div class="float f-bars">
        <div class="glass-card mini">
          <div class="gc-head"><ProductIcon id="kindling" size={24} /><span class="gc-name">Kindling</span><span class="gc-sub">Best days</span></div>
          <BarChart
            labels={['M', 'T', 'W', 'T', 'F', 'S', 'S']}
            views={[{ key: 'k', label: 'Completion by weekday', values: showcase.kindling.bars.values, unit: { suffix: '%' } }]}
            color={kindling.accent}
            height={92}
            highlightMax
            label="Kindling sample chart: habit completion by weekday"
          />
        </div>
      </div>

      <div class="float f-stat">
        <div class="glass-card mini stat">
          <ProductIcon id="studyhub" size={32} />
          <span class="stat-text">
            <span class="stat-label">StudyHub · study streak</span>
            <Counter value={14} unit={{ suffix: ' days' }} class="stat-value" />
          </span>
        </div>
      </div>
      </div>
      <p class="stage-note"><span class="sample-note">Product previews · sample data</span></p>
    </div>

    <ul class="product-strip rise" style="--reveal-delay: 560ms" aria-label="Our products">
      {products.map((p) => (
        <li>
          <a href={`/products/${p.id}`} class="strip-item" style={`--p-accent:${p.accent};--p-soft:${p.accentSoft}`}>
            <ProductIcon id={p.id} size={36} />
            <span class="strip-text">
              <span class="strip-name">{p.name}</span>
              <span class="strip-cat">{p.category}</span>
            </span>
            <Icon name="arrow-up-right" size={16} class="strip-arrow" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: calc(var(--header-h) * -1);
    padding-top: calc(var(--header-h) + clamp(3.5rem, 2rem + 7vw, 8rem));
    padding-bottom: clamp(4rem, 2rem + 6vw, 7rem);
    overflow: hidden;
    text-align: center;
  }

  /* ---- Animated background light ---- */
  .hero-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.75;
    will-change: transform;
  }
  .b1 {
    width: min(760px, 95vw);
    height: 460px;
    top: -140px;
    left: 50%;
    margin-left: min(-380px, -47.5vw);
    background: radial-gradient(closest-side, var(--glow-1), transparent);
    animation: drift-a 22s ease-in-out infinite alternate;
  }
  .b2 {
    width: 520px;
    height: 420px;
    top: 120px;
    right: -180px;
    background: radial-gradient(closest-side, var(--glow-2), transparent);
    animation: drift-b 26s ease-in-out infinite alternate;
  }
  .b3 {
    width: 480px;
    height: 380px;
    top: 260px;
    left: -200px;
    background: radial-gradient(closest-side, var(--glow-3), transparent);
    animation: drift-a 30s ease-in-out infinite alternate-reverse;
  }
  @keyframes drift-a { to { transform: translate(60px, 40px) scale(1.12); } }
  @keyframes drift-b { to { transform: translate(-70px, 30px) scale(0.92); } }
  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--dot) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 65% 50% at 50% 28%, #000 10%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse 65% 50% at 50% 28%, #000 10%, transparent 72%);
  }

  /* ---- Copy ---- */
  .hero-inner { display: flex; flex-direction: column; align-items: center; }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.95rem 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--glass);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .pill-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .pill-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    animation: ping 2.4s var(--ease-out) infinite;
  }
  @keyframes ping { from { transform: scale(0.6); opacity: 0.8; } to { transform: scale(1.6); opacity: 0; } }

  h1 {
    margin-top: 1.75rem;
    font-size: var(--fs-h1);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.98;
    max-width: 14ch;
  }
  .lede {
    margin-top: 1.6rem;
    max-width: 56ch;
    font-size: var(--fs-lg);
    color: var(--text-muted);
  }
  .actions { margin-top: 2.4rem; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .btn-lg { min-height: 52px; padding-inline: 1.6rem; font-size: 1rem; }

  /* ---- Stage of floating previews ---- */
  .stage {
    position: relative;
    width: 100%;
    max-width: 1080px;
    margin-top: clamp(3.5rem, 2rem + 5vw, 5.5rem);
    display: grid;
    gap: 0.9rem;
    grid-template-columns: 1fr 1fr;
    text-align: left;
  }
  .float { animation: float 9s ease-in-out infinite; }
  .f-ring { animation-delay: -3s; }
  .f-bars { animation-delay: -5s; }
  .f-stat { animation-delay: -1.5s; }
  @keyframes float { 50% { transform: translateY(-8px); } }
  .f-main { grid-column: 1 / -1; }
  .f-stat { grid-column: 1 / -1; }

  .glass-card {
    height: 100%;
    padding: 1.15rem 1.2rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--glass-strong);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-lg), 0 0 0 1px var(--border);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
  }
  .glass-card.mini { padding: 1rem; display: grid; gap: 0.8rem; align-content: start; }
  .gc-head { display: flex; align-items: center; gap: 0.55rem; margin-bottom: 0.4rem; min-width: 0; }
  .gc-name { font-weight: 600; font-size: 0.9rem; }
  .gc-sub { margin-left: auto; font-size: 0.72rem; color: var(--text-faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .stat { display: flex; align-items: center; gap: 0.8rem; }
  .stat-text { display: grid; gap: 0.1rem; }
  .stat-label { font-size: 0.74rem; color: var(--text-faint); }
  .stat :global(.stat-value) { font-size: 1.35rem; font-weight: 500; }
  .stage-note { grid-column: 1 / -1; text-align: center; margin-top: 0.4rem; }

  .col-right { display: contents; }
  @media (min-width: 900px) {
    .stage {
      grid-template-columns: 0.8fr 1.7fr 0.9fr;
      align-items: start;
      gap: 1.1rem;
    }
    .f-ring { grid-column: 1; grid-row: 1; margin-top: 4rem; }
    .f-main { grid-column: 2; grid-row: 1; }
    .col-right { grid-column: 3; grid-row: 1; display: flex; flex-direction: column; gap: 1.1rem; margin-top: 1.75rem; }
  }

  /* ---- Product strip ---- */
  .product-strip {
    margin-top: clamp(3rem, 2rem + 4vw, 4.5rem);
    display: grid;
    gap: 0.75rem;
    width: 100%;
    max-width: 1080px;
  }
  .strip-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--glass);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    text-align: left;
    transition: border-color 0.3s, transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out), background-color 0.3s;
  }
  .strip-item:hover {
    border-color: color-mix(in srgb, var(--p-accent) 40%, transparent);
    background: var(--surface-2);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .strip-text { display: grid; line-height: 1.3; flex: 1; }
  .strip-name { font-weight: 600; font-size: 0.95rem; }
  .strip-cat { font-size: var(--fs-xs); color: var(--text-faint); }
  .strip-item :global(.strip-arrow) { color: var(--text-faint); transition: transform 0.35s var(--ease-out), color 0.3s; }
  .strip-item:hover :global(.strip-arrow) { color: var(--p-accent); transform: translate(2px, -2px); }

  @media (min-width: 560px) {
    .product-strip { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .product-strip { grid-template-columns: repeat(4, 1fr); }
  }
</style>
