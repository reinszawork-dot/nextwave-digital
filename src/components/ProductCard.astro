---
import Icon from './Icon.astro';
import ProductIcon from './ProductIcon.astro';
import ProductPreview from './ProductPreview.astro';
import type { Product } from '../data/products';

interface Props {
  product: Product;
  index?: number;
}
const { product, index = 0 } = Astro.props;
const headingId = `product-${product.id}-title`;
---

<article
  class="card reveal"
  aria-labelledby={headingId}
  data-spotlight
  style={`--p-accent:${product.accent};--p-soft:${product.accentSoft};--reveal-delay:${(index % 2) * 110}ms`}
>
  <div class="card-top">
    <div class="card-head">
      <ProductIcon id={product.id} size={46} />
      <span class="tag">{product.category}</span>
      {product.appUrl && <span class="live"><span class="live-dot" aria-hidden="true"></span>Live</span>}
    </div>

    <h3 id={headingId}>{product.name}</h3>
    <p class="summary">{product.summary}</p>
  </div>

  <div class="preview">
    <ProductPreview id={product.id} />
  </div>

  <div class="card-actions">
    {product.appUrl && (
      <a href={product.appUrl} class="btn btn-primary card-open" target="_blank" rel="noopener" aria-label={`Open the ${product.name} app (opens in a new tab)`}>
        Open app
        <Icon name="arrow-up-right" size={16} />
      </a>
    )}
    <a href={`/products/${product.id}`} class="btn btn-ghost card-btn" aria-label={`View ${product.name}, our ${product.category.toLowerCase()} app`}>
      View product
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    isolation: isolate;
    transition:
      opacity 1s var(--ease-out),
      transform 0.6s var(--ease-out),
      box-shadow 0.5s var(--ease-out),
      border-color 0.3s;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(360px circle at var(--mx, 50%) var(--my, -30%), var(--p-soft), transparent 70%),
      linear-gradient(180deg, transparent 55%, color-mix(in srgb, var(--p-soft) 60%, transparent));
    transition: opacity 0.4s;
  }
  .card.is-visible:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--p-accent) 28%, var(--border));
    box-shadow: var(--shadow-lg);
  }
  .card-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.4rem; }
  .tag {
    font-size: var(--fs-xs);
    font-weight: 500;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    color: color-mix(in srgb, var(--p-accent) 80%, black);
    background: var(--p-soft);
  }
  .live {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .live-dot { width: 6px; height: 6px; border-radius: 50%; background: #4f8a68; box-shadow: 0 0 0 3px rgba(79, 138, 104, 0.18); }
  h3 { font-family: var(--font-serif); font-size: clamp(1.8rem, 1.5rem + 1vw, 2.3rem); font-weight: 400; letter-spacing: -0.025em; }
  .summary { margin-top: 0.6rem; color: var(--text-muted); font-size: var(--fs-sm); max-width: 46ch; }
  .preview { margin-block: 1.75rem; flex: 1; }
  .card-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .card-open { --btn-bg: color-mix(in srgb, var(--p-accent) 78%, #1e1d1a); }
  .card-btn:hover { border-color: color-mix(in srgb, var(--p-accent) 45%, transparent); }
</style>
