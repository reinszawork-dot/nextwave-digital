---
import Icon from './Icon.astro';
import type { IconName } from './icon-names';
import { getProduct, type ProductId } from '../data/products';

interface Props {
  id: ProductId;
  size?: number;
}
const { id, size = 48 } = Astro.props;
const product = getProduct(id)!;
const icons: Record<ProductId, IconName> = { wisely: 'wallet', lull: 'moon', kindling: 'flame', studyhub: 'cap', forge: 'dumbbell', cashbook: 'chart-column' };
---

<span
  class="product-icon"
  style={`--size:${size}px;--p-accent:${product.accent};--p-soft:${product.accentSoft}`}
  aria-hidden="true"
>
  {id === 'studyhub' ? (
    /* StudyHub's own mark: an open book with a graduation cap */
    <svg class="logo-mark" width={Math.round(size * 0.66)} height={Math.round(size * 0.66)} viewBox="0 0 48 48">
      <path d="M24 18c-5-3.6-11.4-4.6-18-3.8v24c6.6-.8 13 .2 18 3.8z" fill="#a9d6d2" />
      <path d="M24 18c5-3.6 11.4-4.6 18-3.8v24c-6.6-.8-13 .2-18 3.8z" fill="#3a8a86" />
      <path d="M24 18v24" stroke="#0b2f2c" stroke-opacity=".35" stroke-width="1.6" />
      <path d="M24 3.5 37 9.5 24 15.5 11 9.5z" fill="#2c4f4d" />
      <path d="M17 12.2v3.6c3.8 2.6 10.2 2.6 14 0v-3.6" fill="#2c4f4d" opacity=".85" />
      <path d="M37 9.5v6.5" stroke="#2c4f4d" stroke-width="1.6" stroke-linecap="round" />
      <circle cx="37" cy="17" r="1.6" fill="#2c4f4d" />
    </svg>
  ) : (
    <Icon name={icons[id]} size={Math.round(size * 0.5)} />
  )}
</span>

<style>
  .product-icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: calc(var(--size) * 0.3);
    color: var(--p-accent);
    background:
      linear-gradient(160deg, var(--p-soft), transparent 70%),
      var(--surface-2);
    border: 1px solid color-mix(in srgb, var(--p-accent) 22%, var(--border));
    box-shadow: 0 1px 2px rgba(30, 25, 15, 0.05), 0 6px 16px -10px color-mix(in srgb, var(--p-accent) 60%, transparent);
  }
</style>
