---
/**
 * NextWave Digital wordmark: a charcoal tile with a clay wave, "Next" in sans,
 * "Wave" in serif italic and a quiet "Digital". `compact` hides the suffix.
 */
interface Props {
  compact?: boolean;
  class?: string;
}
const { compact = false, class: className = '' } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="9" fill="#1e1d1a"></rect>
    <path
      class="logo-wave"
      d="M6.5 18.5c2.6 0 3.6-5.5 6.4-5.5s3.7 6.5 6.6 6.5 3.6-6.5 6-6.5"
      fill="none"
      stroke="#e4a07c"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      pathLength="1"></path>
  </svg>
  <span class="logo-text">
    <span class="logo-name">Next<em>Wave</em></span>
    {!compact && <span class="logo-suffix">Digital</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    line-height: 1;
    color: var(--text);
  }
  .logo-mark { width: 30px; height: 30px; flex: none; }
  .logo-wave {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: logo-draw 1.4s var(--ease-out) 0.15s both;
  }
  @keyframes logo-draw { from { stroke-dashoffset: 1; } }
  :global(a:hover) > .logo .logo-wave { animation: logo-draw 1s var(--ease-out); }
  .logo-text { display: inline-flex; align-items: baseline; gap: 0.32rem; font-size: 1.12rem; }
  .logo-name { font-weight: 600; letter-spacing: -0.03em; }
  .logo-name em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.12em;
    letter-spacing: -0.01em;
    color: var(--accent);
    margin-left: 1px;
  }
  .logo-suffix { font-weight: 400; color: var(--text-faint); letter-spacing: -0.01em; }
</style>
