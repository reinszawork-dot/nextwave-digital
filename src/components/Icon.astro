---
/**
 * Site-wide icon component backed by Lucide (https://lucide.dev).
 * Keeps a small, named set so every icon on the site stays consistent.
 */
import {
  ArrowRight,
  ArrowLeft,
  ArrowUpRight,
  Wallet,
  Moon,
  Sun,
  Flame,
  ShieldCheck,
  WifiOff,
  Sparkles,
  Mail,
  Menu,
  X,
  Check,
  ExternalLink,
  Target,
  Compass,
  Layers,
  GraduationCap,
  ChartLine,
  ChartColumn,
  Gauge,
  Smartphone,
  UserX,
  Feather,
  Quote,
  Activity,
  Dumbbell,
} from '@lucide/astro';
import type { IconName } from './icon-names';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
  strokeWidth?: number;
}
const { name, size = 24, class: className, label, strokeWidth = 1.6 } = Astro.props;

const icons = {
  'arrow-right': ArrowRight,
  'arrow-left': ArrowLeft,
  'arrow-up-right': ArrowUpRight,
  wallet: Wallet,
  moon: Moon,
  sun: Sun,
  flame: Flame,
  shield: ShieldCheck,
  offline: WifiOff,
  spark: Sparkles,
  mail: Mail,
  menu: Menu,
  close: X,
  check: Check,
  external: ExternalLink,
  target: Target,
  compass: Compass,
  layers: Layers,
  cap: GraduationCap,
  'chart-line': ChartLine,
  'chart-column': ChartColumn,
  gauge: Gauge,
  phone: Smartphone,
  'no-account': UserX,
  feather: Feather,
  quote: Quote,
  activity: Activity,
  dumbbell: Dumbbell,
} as const;

const Cmp = icons[name];
---

<Cmp
  class={className}
  size={size}
  stroke-width={strokeWidth}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
/>
