---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { principles } from '../data/products';
import { site } from '../data/site';
---

<section id="about" class="section about" aria-labelledby="about-title">
  <div class="container about-grid">
    <SectionHeading eyebrow="About us" title="Practical tools for the everyday." emphasis="the everyday." id="about-title">
      <p>
        {site.name} develops digital tools that make everyday tasks easier, more organised and more
        productive. We focus on the moments people deal with every day: planning a month's money,
        winding down after a stressful day, sticking to the routines that matter and staying on top of studies.
      </p>
    </SectionHeading>

    <blockquote class="about-copy reveal" style="--reveal-delay: 120ms">
      <Icon name="quote" size={22} class="q" />
      <p>
        Every product we build starts with a real, everyday problem and a simple question: what
        is the clearest, calmest way to help? The answer is software that feels effortless —
        focused on one job, honest about what it does and respectful of your time and your data.
      </p>
    </blockquote>

    <ul class="principles">
      {principles.map((p, i) => (
        <li class="principle reveal" style={`--reveal-delay:${i * 90}ms`} data-spotlight>
          <span class="principle-icon"><Icon name={p.icon} size={20} /></span>
          <span class="principle-num num">0{i + 1}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about-grid { display: grid; gap: 2.5rem 5rem; }
  .about-copy {
    margin: 0;
    padding-left: 1.4rem;
    border-left: 1px solid var(--border-strong);
  }
  .about-copy :global(.q) { color: var(--accent); margin-bottom: 0.9rem; }
  .about-copy p {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem);
    line-height: 1.45;
    color: var(--text);
    max-width: 40ch;
  }

  .principles { grid-column: 1 / -1; display: grid; gap: 1rem; margin-top: 1.5rem; }
  .principle {
    position: relative;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: box-shadow 0.4s var(--ease-out), transform 0.4s var(--ease-out), border-color 0.3s;
  }
  .principle::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(260px circle at var(--mx, -200px) var(--my, -200px), rgba(194, 106, 72, 0.08), transparent 70%);
    pointer-events: none;
  }
  .principle.is-visible:hover { box-shadow: var(--shadow); transform: translateY(-3px); border-color: var(--border-strong); }
  .principle-icon {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    color: var(--accent);
    background: var(--accent-soft);
    margin-bottom: 1.4rem;
  }
  .principle-num { position: absolute; top: 1.75rem; right: 1.75rem; font-size: 0.75rem; color: var(--text-faint); }
  .principle h3 { font-size: var(--fs-h3); font-weight: 500; margin-bottom: 0.5rem; }
  .principle p { color: var(--text-muted); font-size: var(--fs-sm); }

  @media (min-width: 900px) {
    .about-grid { grid-template-columns: 1.15fr 1fr; align-items: end; }
    .principles { grid-template-columns: repeat(3, 1fr); }
  }
</style>
