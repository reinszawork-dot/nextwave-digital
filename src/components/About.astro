---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { principles } from '../data/products';
import { site } from '../data/site';
---

<section id="about" class="section about" aria-labelledby="about-title">
  <div class="container about-grid">
    <SectionHeading eyebrow="About us" title="Practical tools for the everyday." id="about-title">
      <p>
        {site.name} develops digital tools that make everyday tasks easier, more organised and more
        productive. We focus on the moments people deal with every day: planning a month's money,
        winding down after a stressful day, and sticking to the routines that matter.
      </p>
    </SectionHeading>

    <div class="about-copy reveal" style="--reveal-delay: 120ms">
      <p>
        Every product we build starts with a real, everyday problem and a simple question: what
        is the clearest, calmest way to help? The answer is software that feels effortless —
        focused on one job, honest about what it does and respectful of your time and your data.
      </p>
    </div>

    <ul class="principles">
      {principles.map((p, i) => (
        <li class="principle reveal" style={`--reveal-delay:${i * 90}ms`}>
          <span class="principle-icon"><Icon name={p.icon} size={22} /></span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about-grid { display: grid; gap: 2.5rem 4rem; }
  .about-copy p { color: var(--text-muted); font-size: var(--fs-base); max-width: 56ch; }

  .principles {
    grid-column: 1 / -1;
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .principle {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(20, 27, 49, 0.6), rgba(15, 21, 39, 0.3));
    transition: border-color 0.3s;
  }
  .principle:hover { border-color: var(--border-strong); }
  .principle-icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: var(--accent-bright);
    background: var(--accent-soft);
    border: 1px solid rgba(59, 130, 246, 0.25);
    margin-bottom: 1.25rem;
  }
  .principle h3 { font-size: var(--fs-h3); margin-bottom: 0.5rem; }
  .principle p { color: var(--text-muted); font-size: var(--fs-sm); }

  @media (min-width: 900px) {
    .about-grid { grid-template-columns: 1.1fr 1fr; align-items: end; }
    .principles { grid-template-columns: repeat(3, 1fr); }
  }
</style>
